<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>

    <p><strong>Name:</strong> <%= name %></p>
    <p><strong>Username:</strong> <%= email %></p>
    <p><strong>Role:</strong> <%= role %></p>

    <% if (user && user.role_name === 'admin') { %>
        <hr>

        <h3>Administrator</h3>

        <p>
            <a href="/users">View Registered Users</a>
        </p>
    <% } %>

</main>

<%- include('partials/footer') %>