<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>

    <p><strong>Name:</strong> <%= name %></p>
    <p><strong>Username:</strong> <%= email %></p>
    <p><strong>Role:</strong> <%= role %></p>

    <% if (user && user.role_name === 'admin') { %>
        <hr>

        <h3>Administrator</h3>

        <p>
            <a href="/users">View Registered Users</a>
        </p>
    <% } %>

    <hr>

<h3>My Volunteer Projects</h3>

<% if (volunteerProjects.length === 0) { %>

    <p>You have not signed up to volunteer for any projects.</p>

<% } else { %>

    <ul>

        <% volunteerProjects.forEach(project => { %>

            <li>

                <strong><%= project.title %></strong>

                (<%= new Date(project.project_date).toLocaleDateString() %>)

                <a href="/project/<%= project.project_id %>/remove-volunteer">
                    Remove Volunteer
                </a>

            </li>

        <% }); %>

    </ul>

<% } %>

</main>

<%- include('partials/footer') %>