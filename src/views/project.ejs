<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2><%= project.title %></h2>

    <p><strong>Description:</strong> <%= project.description %></p>

    <p><strong>Location:</strong> <%= project.location %></p>

    <p><strong>Date:</strong> <%= new Date(project.project_date).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    }) %></p>

    <p>
        <strong>Organization:</strong>
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>

    <p>
        <strong>Categories:</strong>
    </p>
    <p>
        <% categories.forEach(category => { %>
            <a href="/category/<%= category.category_id %>">
                <%= category.name %>
            </a>
        <% }); %>

    </p>

    <p>
    <% if (user && user.role_name === 'admin') { %>
        <a href="/edit-project/<%= project.project_id %>">
            Edit Project
        </a>
    <% } %>
    </p>

    <p>
    <% if (user && user.role_name === 'admin') { %>
        <a href="/project/<%= project.project_id %>/assign-categories">
            Edit Project Categories
        </a>
    <% } %>
    </p>
    <p
        <a href="/projects">Back to Projects</a>
    </p>
</main>

<%- include('partials/footer') %>